<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Steel Frame AR — Monitor de noticias</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#EBEDEF; --surface:#FFFFFF; --ink:#14191D; --muted:#5B6670;
    --line:#C6CDD2;
    /* acentos: naranja rgb(255,153,0) y rojo-naranja rgb(255,51,0) */
    --steel:#FF9900; --steel-dark:#CC7A00;
    --safety:#FF3300; --safety-dark:#CC2900;
    --grad: linear-gradient(90deg, #FF9900, #FF3300);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg);color:var(--ink);font-family:'Barlow', sans-serif;line-height:1.55;}
  .mono{font-family:'IBM Plex Mono', monospace;}
  .stud-band{height:14px;background:var(--grad);}
  header.masthead{background:var(--surface);border-bottom:1px solid var(--line);}
  .masthead-inner{max-width:1180px;margin:0 auto;padding:32px 24px 0;}
  .eyebrow{font-family:'IBM Plex Mono', monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--safety-dark);display:flex;align-items:center;gap:8px;}
  .eyebrow::before{content:"";width:10px;height:10px;background:var(--grad);display:inline-block;border-radius:50%;}
  h1.title{font-family:'Barlow Condensed', sans-serif;font-weight:700;text-transform:uppercase;font-size:clamp(34px, 5.5vw, 56px);letter-spacing:0.01em;margin:6px 0 4px;color:var(--ink);}
  h1.title span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
  p.tagline{font-size:16px;color:var(--muted);max-width:560px;margin:0 0 24px;}
  .title-block{display:grid;grid-template-columns:repeat(4, 1fr);border:1px solid var(--line);border-bottom:none;margin-top:8px;}
  .tb-cell{padding:10px 16px;border-right:1px solid var(--line);border-top:2px solid transparent;}
  .tb-cell:hover{border-top:2px solid var(--steel);}
  .tb-cell:last-child{border-right:none;}
  .tb-label{font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:3px;}
  .tb-value{font-family:'Barlow', sans-serif;font-size:15px;font-weight:700;color:var(--ink);}
  .filter-bar{max-width:1180px;margin:0 auto;padding:18px 24px 4px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
  .filter-bar.secondary{padding-top:0;padding-bottom:20px;gap:14px;}
  .filter-label{font-family:'IBM Plex Mono', monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin-right:6px;}
  .pill{font-family:'Barlow', sans-serif;font-weight:600;font-size:13px;padding:7px 14px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;border-radius:2px;transition:all .15s ease;}
  .pill:hover{border-color:var(--steel);color:var(--steel-dark);}
  .pill.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 2px 10px rgba(255,51,0,0.35);}
  .select-group{display:flex;align-items:center;gap:8px;}
  .select-group label{font-family:'IBM Plex Mono', monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);}
  .select-group select{
    font-family:'Barlow', sans-serif;
    font-weight:600;
    font-size:13px;
    padding:7px 10px;
    border:1px solid var(--line);
    background:var(--surface);
    color:var(--ink);
    border-radius:2px;
    cursor:pointer;
  }
  .select-group select:hover{border-color:var(--steel);}
  .no-results{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    color:var(--muted);
    padding:40px 0;
    text-align:center;
    display:none;
  }
  main{max-width:1180px;margin:0 auto;padding:24px 24px 60px;}
  .grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:22px;}
  @media (max-width:900px){ .grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:620px){ .grid{grid-template-columns:1fr;} .title-block{grid-template-columns:repeat(2,1fr);} }
  .card{position:relative;background:var(--surface);border:1px solid var(--line);display:flex;flex-direction:column;transition:border-color .15s ease, transform .15s ease, box-shadow .15s ease;}
  .card:hover{border-color:transparent; transform:translateY(-3px); box-shadow:0 10px 26px rgba(255,102,0,0.22);}
  .card::before, .card::after, .card .bracket-br, .card .bracket-bl{content:"";position:absolute;width:14px;height:14px;z-index:2;pointer-events:none;}
  .card::before{ top:-1px; left:-1px; border-top:2px solid var(--steel); border-left:2px solid var(--steel); }
  .card::after{ top:-1px; right:-1px; border-top:2px solid var(--safety); border-right:2px solid var(--safety); }
  .card .bracket-bl{ bottom:-1px; left:-1px; border-bottom:2px solid var(--safety); border-left:2px solid var(--safety); }
  .card .bracket-br{ bottom:-1px; right:-1px; border-bottom:2px solid var(--steel); border-right:2px solid var(--steel); }
  .card-img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:var(--bg);}
  .card-img.placeholder{display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;}
  .card-body{padding:18px 18px 20px;display:flex;flex-direction:column;flex:1;}
  .tag-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  .cat-tag{font-family:'IBM Plex Mono', monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;padding:3px 8px;border-radius:2px;}
  .cat-tag.mercado{background:#FFF1E0;color:var(--steel-dark);}
  .cat-tag.normativa{background:#F3EFE8;color:#6B5A2E;}
  .cat-tag.obra{background:#FFE9E0;color:var(--safety-dark);}
  .cat-tag.sustentabilidad{background:#E9F5F0;color:#1F6E52;}
  .cat-tag.capacitacion{background:#F6EDF0;color:#7A3450;}
  .cat-tag.actualidad{background:#EFEFEF;color:#444441;}
  .scope-tag{font-family:'IBM Plex Mono', monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.06em;padding:2px 7px;border-radius:2px;border:1px solid var(--line);color:var(--muted);}
  .scope-tag.regional{border-color:var(--safety);color:var(--safety-dark);}
  .card-date{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--muted);}
  h3.card-title{font-family:'Barlow Condensed', sans-serif;font-weight:700;font-size:21px;line-height:1.24;margin:0 0 10px;color:var(--ink);}
  p.card-summary{font-size:14px;color:var(--muted);margin:0 0 16px;flex:1;}
  .card-footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:12px;margin-top:auto;}
  .card-source{font-family:'Barlow', sans-serif;font-size:13px;color:var(--ink);font-weight:600;}
  a.read-link{font-family:'Barlow', sans-serif;font-weight:600;font-size:13px;color:var(--steel-dark);text-decoration:none;border-bottom:2px solid var(--steel);padding-bottom:1px;transition:color .15s ease, border-color .15s ease;}
  a.read-link:hover{color:var(--safety-dark); border-color:var(--safety);}
  footer{border-top:1px solid var(--line);padding:22px 24px 40px;max-width:1180px;margin:0 auto;font-family:'IBM Plex Mono', monospace;font-size:12px;color:var(--muted);}
</style>
</head>
<body>

<div class="stud-band" aria-hidden="true"></div>

<header class="masthead">
  <div class="masthead-inner">
    <span class="eyebrow">Monitor automático · Argentina</span>
    <h1 class="title">Steel Frame <span>AR</span></h1>
    <p class="tagline">Noticias sobre construcción en seco y steel frame recopiladas de diarios, portales especializados y fuentes técnicas del sector.</p>
    <div class="title-block">
      <div class="tb-cell"><span class="tb-label">Fuentes monitoreadas</span><span class="tb-value">{{ sources_count }}</span></div>
      <div class="tb-cell"><span class="tb-label">Noticias publicadas</span><span class="tb-value">{{ news|length }}</span></div>
      <div class="tb-cell"><span class="tb-label">Última actualización</span><span class="tb-value">{{ generated_at }}</span></div>
      <div class="tb-cell"><span class="tb-label">Próxima corrida</span><span class="tb-value">{{ next_run }}</span></div>
    </div>
  </div>
</header>

<div class="filter-bar">
  <span class="filter-label">Categoría</span>
  <button class="pill active" data-filter="todas">Todas</button>
  {% for cat in categories %}
  <button class="pill" data-filter="{{ cat }}">{{ cat|capitalize }}</button>
  {% endfor %}
</div>

<div class="filter-bar">
  <span class="filter-label">Alcance</span>
  <button class="pill scope-pill active" data-scope-filter="todas">Todas</button>
  <button class="pill scope-pill" data-scope-filter="nacional">Nacional (Argentina)</button>
  <button class="pill scope-pill" data-scope-filter="regional">Regional (Latinoamérica)</button>
</div>

<div class="filter-bar secondary">
  <div class="select-group">
    <label for="sort-select">Ordenar por</label>
    <select id="sort-select">
      <option value="newest">Más nuevas primero</option>
      <option value="oldest">Más antiguas primero</option>
    </select>
  </div>
  <div class="select-group">
    <label for="source-select">Fuente</label>
    <select id="source-select">
      <option value="todas">Todas las fuentes</option>
      {% for src in sources_list %}
      <option value="{{ src }}">{{ src }}</option>
      {% endfor %}
    </select>
  </div>
</div>

<main>
  <div class="grid" id="grid">
    {% for n in news %}
    <article class="card" data-cat="{{ n.category }}" data-source="{{ n.source }}" data-date="{{ n.published or '' }}" data-scope="{{ n.scope or 'nacional' }}">
      <span class="bracket-bl" aria-hidden="true"></span><span class="bracket-br" aria-hidden="true"></span>
      {% if n.image %}
      <img class="card-img" src="{{ n.image }}" alt="">
      {% else %}
      <div class="card-img placeholder">Sin imagen disponible</div>
      {% endif %}
      <div class="card-body">
        <div class="tag-row">
          <span class="cat-tag {{ n.category }}">{{ n.category|capitalize }}</span>
          <span class="card-date">{{ n.published_display }}</span>
        </div>
        <span class="scope-tag {{ n.scope or 'nacional' }}" style="margin-bottom:10px;display:inline-block;width:fit-content;">{{ 'Regional' if n.scope == 'regional' else 'Nacional' }}</span>
        <h3 class="card-title">{{ n.title }}</h3>
        <p class="card-summary">{{ n.summary }}</p>
        <div class="card-footer">
          <span class="card-source">{{ n.source }}</span>
          <a class="read-link" href="{{ n.url }}" target="_blank" rel="noopener">Leer nota completa →</a>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
  <p class="no-results" id="no-results">Ninguna noticia coincide con esos filtros.</p>
</main>

<footer>
  Generado automáticamente por el agente de monitoreo · {{ news|length }} noticias · {{ generated_at }}
</footer>

<script>
  const pills = document.querySelectorAll('.pill:not(.scope-pill)');
  const scopePills = document.querySelectorAll('.scope-pill');
  const sortSelect = document.getElementById('sort-select');
  const sourceSelect = document.getElementById('source-select');
  const grid = document.getElementById('grid');
  const noResults = document.getElementById('no-results');

  let activeCategory = 'todas';
  let activeScope = 'todas';

  function applyFilters() {
    const activeSource = sourceSelect.value;
    const sortOrder = sortSelect.value;

    // ordenar todas las tarjetas por fecha, y reinsertarlas en el DOM
    const cards = Array.from(grid.querySelectorAll('.card'));
    cards.sort((a, b) => {
      const dateA = a.dataset.date || '';
      const dateB = b.dataset.date || '';
      return sortOrder === 'newest' ? dateB.localeCompare(dateA) : dateA.localeCompare(dateB);
    });
    cards.forEach(card => grid.appendChild(card));

    // mostrar/ocultar según categoría + fuente + alcance
    let visibleCount = 0;
    cards.forEach(card => {
      const matchesCategory = activeCategory === 'todas' || card.dataset.cat === activeCategory;
      const matchesSource = activeSource === 'todas' || card.dataset.source === activeSource;
      const matchesScope = activeScope === 'todas' || card.dataset.scope === activeScope;
      const visible = matchesCategory && matchesSource && matchesScope;
      card.style.display = visible ? 'flex' : 'none';
      if (visible) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCategory = pill.dataset.filter;
      applyFilters();
    });
  });

  scopePills.forEach(pill => {
    pill.addEventListener('click', () => {
      scopePills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeScope = pill.dataset.scopeFilter;
      applyFilters();
    });
  });

  sortSelect.addEventListener('change', applyFilters);
  sourceSelect.addEventListener('change', applyFilters);

  applyFilters();
</script>

</body>
</html>
